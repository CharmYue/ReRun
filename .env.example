# ===========================================
# ReRun — Environment Configuration
# Copy this file to .env and fill in your values
# ===========================================

# --- LLM Provider ---
# OpenAI API key (required for AI-generated events)
# Leave empty to run in offline mode (fallback event pool)
OPENAI_API_KEY=

# Optional base URL for OpenAI-compatible providers.
# Example for Azure OpenAI:
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
OPENAI_BASE_URL=

# Model to use.
# For Azure OpenAI, set this to your deployment name.
OPENAI_MODEL=gpt-4o-mini

# Temperature for LLM generation (0.0-2.0, default: 0.9)
# Higher = more creative/random
LLM_TEMPERATURE=0.9

# --- Game Settings ---
# Language: cn (中文) or en (English)
GAME_LANGUAGE=cn

# Typewriter effect speed in seconds per character (0 to disable)
TYPEWRITER_SPEED=0.03

# --- Debug ---
# Enable debug logging (true/false)
DEBUG=false
