[21.593, "o", "\r\n  🪙 你的 BTC ×7.83： ¥19.6万 → ¥39.2万 (+100%)\r\n  💵 收入：无业状态，无工资收入\r\n  🏠 年支出：¥8.2万\r\n      （日常开支 ¥4.8万 + 房租 ¥3.4万）\r\n  📊 年结余：-¥8.2万  ← 入不敷出\r\n\r\n  📅 2019 年 | 💼 待业中 | 💵 月薪 ¥6,548\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n  💰 存款: ¥74.7万    🪙 BTC ×7.83: ¥39.2万\r\n  💎 净资产: ¥113.9万\r\n  😰 压力: ■■■■■■■□□□ 75%    ← 超80%触发坏事，满了=住院\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n  [按回车继续...]"]
[21.89, "i", "\r\n"]
