[34.89, "o", "\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n  📅 2022 年\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n  🪙 BTC 价格：¥300,000 → ¥120,000  (最低 ¥110,000 / 最高 ¥310,000)\r\n\r\n  【Boss关】三重暴击。BTC腰斩、大厂裁员潮、FTX崩盘。基金亏损、房价开始松动。这\r\n一年，活着就是胜利。\r\n\r\n  [按回车继续...]"]
