[10.406, "o", "\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n  📅 2017 年\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n  🪙 BTC 价格：¥7,000 → ¥130,000  (最低 ¥6,500 / 最高 ¥140,000)\r\n\r\n  BTC疯牛年。年初7000，年底13万。ICO狂潮让无数人一夜暴富，也让无数人血本无归。\r\n全世界都在问：比特币到底是什么？\r\n\r\n  [按回车继续...]"]
