[15.843, "o", "\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n  📅 2018 年\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n  🪙 BTC 价格：¥130,000 → ¥25,000  (最低 ¥20,000 / 最高 ¥130,000)\r\n\r\n  【Boss关】加密寒冬。BTC跌了80%，无数人割肉离场。P2P暴雷，股市低迷。这一年考验\r\n的是信仰。\r\n\r\n  [按回车继续...]"]
