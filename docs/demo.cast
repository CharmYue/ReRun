[3.734, "o", "\r\n  💵 年收入：¥6万（月薪 ¥5,000）\r\n  🏠 年支出：¥6万\r\n      （日常开支 ¥3.6万 + 房租 ¥2.4万）\r\n  📊 年结余：¥0（刚好收支平衡）\r\n\r\n  📅 2015 年 | 💼 应届毕业生 | 💵 月薪 ¥5,000\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n  💰 存款: ¥3万\r\n  💎 净资产: ¥3万\r\n  😰 压力: ■■□□□□□□□□ 20%    ← 超80%触发坏事，满了=住院\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n  [按回车继续...]"]
[4.047, "i", "\r\n"]
